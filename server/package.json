{
  "name": "sifortak-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "API Sistem Formulasi Pakan: akun, data master, harga acuan, sinkron formula, statistik",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "buat-admin": "node --env-file-if-exists=.env scripts/buat-admin.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "dev:lokal": "node scripts/dev-lokal.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "supertest": "^7.3.2"
  }
}
