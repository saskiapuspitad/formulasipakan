# ===== API Sistem Formulasi Pakan — salin menjadi .env lalu isi =====
NODE_ENV=production

# Alamat & port API (Nginx meneruskan /api ke sini)
HOST=127.0.0.1
PORT=3000

# Koneksi PostgreSQL
DATABASE_URL=postgres://sifortak:GANTI_SANDI_DB@127.0.0.1:5432/sifortak

# Kunci rahasia sesi login — minimal 32 karakter acak.
# Buat dengan:  openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_KUNCI_ACAK_PANJANG

# true bila situs memakai HTTPS (wajib di produksi). Isi false hanya untuk uji lokal via http.
COOKIE_SECURE=true

# Izinkan peternak mendaftar sendiri (false = hanya admin yang membuat akun)
IZINKAN_DAFTAR=true

# (Opsional) Layani folder hasil build frontend langsung dari Node, tanpa Nginx
# STATIC_DIR=/var/www/formulasipakan
